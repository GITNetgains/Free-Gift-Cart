// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model InventorySyncPair {
  id                  String   @id @default(cuid())
  shop                String
  originalVariantId   String
  duplicateVariantId  String
  originalItemId      String
  duplicateItemId     String
  originalTitle       String
  duplicateTitle      String
  locationId          String
  locationName        String
  enabled             Boolean  @default(true)
  sharedQuantity      Int
  originalBaseline    Int
  duplicateBaseline   Int
  pending             String?
  lastSyncedAt        DateTime?
  lastError           String?
  attempts            Int      @default(0)
  nextRunAt           DateTime @default(now())
  lockToken           String?
  lockUntil           DateTime?
  createdAt           DateTime @default(now())
  members             InventorySyncMember[]

  @@index([enabled, nextRunAt])
  @@index([shop])
}

// A variant can only belong to one pair at a location, including paused pairs.
// This prevents circular links and ambiguous shared-stock groups.
model InventorySyncMember {
  id              String @id @default(cuid())
  shop            String
  inventoryItemId String
  locationId      String
  pairId          String
  pair            InventorySyncPair @relation(fields: [pairId], references: [id], onDelete: Cascade)

  @@unique([shop, inventoryItemId, locationId])
}
