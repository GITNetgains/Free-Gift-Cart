{% assign gift_settings = shop.metafields.free_gift_cart.settings.value %}
{% assign tier_settings = shop.metafields.tiered_gift.settings.value %}

{% if tier_settings != blank and tier_settings.enabled and tier_settings.tiers.size > 0 and request.page_type == 'cart' %}
  {% comment %}
    Price gifts (spend tiers) are on: the same banner shows progress to the
    next tier, run by tiered-gift-cart-banner.js. Stores without price gift
    settings never reach this branch.
  {% endcomment %}
  <div class="fgcb-root" data-tiered data-shop-currency="{{ shop.currency }}" hidden>
    <script type="application/json" data-fgcb-tiers>{{ tier_settings | json }}</script>
  </div>
  {{ 'free-gift-cart-banner.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'tiered-gift-cart-banner.js' | asset_url }}" defer></script>
{% elsif gift_settings != blank and gift_settings.enabled and request.page_type == 'cart' %}
  <div class="fgcb-root" data-cart-add-url="{{ routes.cart_add_url }}" data-cart-update-url="{{ routes.cart_update_url }}" hidden>
    <script type="application/json" data-fgcb-settings>{{ gift_settings | json }}</script>
    <script type="application/json" data-fgcb-inventory>
      {
        {% assign inventory_first = true %}
        {% for gift in gift_settings.products %}
          {% if gift.productHandle != blank %}
            {% assign inventory_product = all_products[gift.productHandle] %}
            {% assign inventory_variant_id = gift.variantId | split: '/' | last | plus: 0 %}
            {% for inventory_variant in inventory_product.variants %}
              {% if inventory_variant.id == inventory_variant_id %}
                {% unless inventory_first %},{% endunless %}
                {{ gift.variantId | json }}:
                {% if inventory_variant.inventory_management != blank and inventory_variant.inventory_quantity <= 0 %}false{% else %}{{ inventory_variant.available | json }}{% endif %}
                {% assign inventory_first = false %}
              {% endif %}
            {% endfor %}
          {% endif %}
        {% endfor %}
      }
    </script>
  </div>
  {{ 'free-gift-cart-banner.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'free-gift-cart-banner.js' | asset_url }}" defer></script>
{% endif %}

{% schema %}
{
  "name": "Free Gift Progress Bar",
  "target": "section",
  "settings": []
}
{% endschema %}
